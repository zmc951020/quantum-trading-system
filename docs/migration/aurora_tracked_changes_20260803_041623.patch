ue = sum(p.market_value for p in self._positions.values()) +        return BrokerResult.ok(AccountInfo( +            account_id="aurora_sim_001", +            broker_type=BrokerType.AURORA_SIMULATOR, +            total_asset=self._balance + market_value, +            available_cash=self._balance, +            market_value=market_value, +            total_value=self._balance + market_value +        )) + +    def get_account_info(self) -> AccountInfo: +        result = self.get_account() +        return result.data if result.success else AccountInfo(account_id="") + +    def get_positions(self) -> List[PositionData]: +        return list(self._positions.values()) + +    def place_order( +        self, +        symbol: str, +        side: OrderSide, +        order_type: OrderType, +        quantity: float, +        price: Optional[float] = None, +        stop_price: Optional[float] = None, +    ) -> OrderResult: +        symbol = normalize_symbol(symbol) +        ticker = self.get_ticker(symbol) +        order_price = price or ticker.last_price +        order_id = f"ord_{hash(symbol + str(time.time())) % 1000000}" + +        if side == OrderSide.BUY: +            cost = order_price * quantity +            if cost <= self._balance: +                self._balance -= cost +                if symbol not in self._positions: +                    self._positions[symbol] = PositionData(symbol=symbol, quantity=0) +                pos = self._positions[symbol] +                total_qty = pos.quantity + quantity +                pos.average_cost = (pos.average_cost * pos.quantity + order_price * quantity) / total_qty +                pos.quantity = total_qty +                pos.current_price = order_price +                pos.market_value = pos.quantity * pos.current_price +                status = "filled" +            else: +                status = "rejected" +        else: +            if symbol in self._positions and self._positions[symbol].quantity >= quantity: +         