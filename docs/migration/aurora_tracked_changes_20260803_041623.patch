 str) -> Optional[BrokerInterface]: +        """根据类型创建券商适配器""" +        if broker_type == "aurora_simulator": +            return AuroraSimulatorAdapter() +        elif broker_type == "xbk_westquant": +            return XbkBrokerAdapter() +        elif broker_type == "zhongtai": +            return XbkBrokerAdapter() +        return None + +    def switch_broker(self, broker_type: str) -> Dict[str, Any]: +        """切换券商""" +        adapter = self._create_adapter(broker_type) +        if not adapter: +            return {"success": False, "message": "未知券商类型"} + +        adapter.connect() +        self._brokers[broker_type] = adapter +        self._active_broker = broker_type + +        self._switch_history.append({ +            "timestamp": datetime.now().isoformat(), +            "broker_type": broker_type, +            "broker_name": adapter.name +        }) + +        return { +            "success": True, +            "broker_type": broker_type, +            "broker_name": adapter.name +        } + +    def list_brokers(self) -> List[Dict]: +        """列出已注册券商""" +        return [ +            {"type": k, "name": v.name, "connected": v.connection_state == ConnectionState.CONNECTED} +            for k, v in self._brokers.items() +        ] + +    def health_check(self) -> Dict[str, Any]: +        """系统健康检查""" +        result = { +            "healthy": True, +            "active_broker": self._active_broker, +            "broker_count": len(self._brokers) +        } +        if self._active_broker and self._active_broker in self._brokers: +            broker = self._brokers[self._active_broker] +            result["active_broker_name"] = broker.name +            result["connected"] = broker.connection_state == ConnectionState.CONNECTED +        return result + +    def get_system_status(self) -> Dict[str, Any]: +        """获取系统状态""" +        return { +            "active_broker": self._active_broker, +            "broker_count": len(self._brokers), +            